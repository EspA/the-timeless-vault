# --- App ---
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_ORIGIN=http://localhost:5173
AUTH_ALLOWED_EMAILS=you@gmail.com
ALERT_TO_EMAIL=you@gmail.com
INTERNAL_JOB_TOKEN=change-me-internal-job-token

# Local only: skip Google SSO and sign in as the first allowlisted email
APP_SECURITY_DEV_BYPASS=true

# Local automatic market scans. Each watched set uses its own interval (default 30 minutes).
MARKET_LOCAL_SCHEDULE=true
MARKET_SCAN_DELAY_MS=300000

# --- Google SSO (required when APP_SECURITY_DEV_BYPASS=false) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database ---
POSTGRES_DB=timeless_vault
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
DATABASE_URL=jdbc:postgresql://localhost:5432/timeless_vault

# --- BrickEconomy (100 requests/day — lookups are cached) ---
BRICKECONOMY_API_KEY=
BRICKECONOMY_BASE_URL=https://www.brickeconomy.com/api/v1
BRICKECONOMY_USER_AGENT=TheTimelessVault/1.0

# --- Shopify custom app ---
SHOPIFY_SHOP_DOMAIN=thetimelessvault.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_CATEGORY_ID=
SHOPIFY_LOCATION_NAME=Private Mail Box

# --- BrickLink Store API (OAuth 1.0) ---
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

# --- eBay ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
# Quote this value. eBay refresh tokens contain #, which otherwise starts a comment.
EBAY_REFRESH_TOKEN=
EBAY_ENV=PRODUCTION
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_ID=19006
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
# Market watch always searches live eBay.com. Sandbox keys cannot see real listings.
EBAY_BROWSE_CLIENT_ID=
EBAY_BROWSE_CLIENT_SECRET=

# --- Photos: leave GCS_BUCKET empty to store files on local disk ---
GCS_BUCKET=
GCS_PROJECT_ID=
LOCAL_PHOTO_DIR=./data/photos

# --- Email (Mailpit locally: smtp://localhost:1025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=vault@thetimelessvault.com
