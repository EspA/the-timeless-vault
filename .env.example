# --- App ---
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_ORIGIN=http://localhost:5173
AUTH_ALLOWED_EMAILS=you@gmail.com
ALERT_TO_EMAIL=you@gmail.com
INTERNAL_JOB_TOKEN=change-me-internal-job-token

# Local only: skip Google SSO and sign in as the first allowlisted email
APP_SECURITY_DEV_BYPASS=true

# Local automatic market scans. Each watched set uses its own interval (default 30 minutes).
MARKET_LOCAL_SCHEDULE=true
MARKET_SCAN_DELAY_MS=300000

# Local automatic sales polling from eBay, BrickLink, and Shopify (once per hour).
SALES_LOCAL_SCHEDULE=true
SALES_SYNC_DELAY_MS=3600000

# --- Google SSO (required when APP_SECURITY_DEV_BYPASS=false) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database ---
POSTGRES_DB=timeless_vault
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
DATABASE_URL=jdbc:postgresql://localhost:5432/timeless_vault

# --- BrickEconomy (500 requests/day — lookups are cached) ---
BRICKECONOMY_API_KEY=
BRICKECONOMY_BASE_URL=https://www.brickeconomy.com/api/v1
BRICKECONOMY_USER_AGENT=TheTimelessVault/1.0

# --- Shopify custom app ---
# Client ID + secret refresh the Admin token automatically on first API call.
# SHOPIFY_ADMIN_TOKEN is optional when those are set.
# Sales sync needs the read_orders Admin API scope on that custom app.
SHOPIFY_SHOP_DOMAIN=thetimelessvault.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_CATEGORY_ID=
SHOPIFY_LOCATION_NAME=Private Mail Box

# --- BrickLink Store API (OAuth 1.0) ---
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

# --- Brick Owl Store API ---
# Create a key in the seller account with inventory and order permissions.
BRICKOWL_API_KEY=
BRICKOWL_BASE_URL=https://api.brickowl.com/v1
BRICKOWL_USER_AGENT=TheTimelessVault/1.0

# --- eBay ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
# Quote this value. eBay refresh tokens contain #, which otherwise starts a comment.
EBAY_REFRESH_TOKEN=
EBAY_ENV=PRODUCTION
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_ID=19006
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
# WaitSeeBuy partner Browse proxy (preferred). When WAITSEEBUY_BROWSE_TOKEN is set,
# market watch and catalog Browse go to this host with the static partner token.
# Do not call /identity/v1/oauth2/token on waitseebuy.com — there is no OAuth there.
# Sell / Inventory / user OAuth stay on api.ebay.com.
WAITSEEBUY_BROWSE_HOST=https://waitseebuy.com
WAITSEEBUY_BROWSE_TOKEN=
# Fallback when the partner token is unset: direct eBay Browse via client_credentials.
# Market watch searches live eBay.com. Sandbox keys cannot see real listings.
EBAY_BROWSE_CLIENT_ID=
EBAY_BROWSE_CLIENT_SECRET=
# Required for eBay Application Growth Check / account deletion compliance webhook.
# Generate a random 32-80 character string; must match the value entered in the eBay developer portal.
EBAY_VERIFICATION_TOKEN=
# Must exactly match the URL registered in eBay developer portal (no trailing slash mismatch).
EBAY_ACCOUNT_DELETION_ENDPOINT_URL=https://admin.thetimelessvault.com/webhooks/ebay/account-deletion

# --- Photos: leave GCS_BUCKET empty to store files on local disk ---
GCS_BUCKET=
GCS_PROJECT_ID=
LOCAL_PHOTO_DIR=./data/photos

# --- Email ---
# Local default is Mailpit (http://localhost:8025). That does not reach a real inbox.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=vault@thetimelessvault.com
# Real SMTP (Gmail app password) instead of Mailpit:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# --- Carrier tracking (optional). Used by sales sync to mark In-transit POs Delivered. ---
# UPS: developer.ups.com → REST Tracking API, OAuth client credentials
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# UPS_BASE_URL=https://wwwcie.ups.com
# USPS: developers.usps.com → Tracking v3. Tracking scope often needs a USPS IP agreement.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# FedEx: developer.fedex.com → Track API, OAuth client credentials (API key + secret)
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
